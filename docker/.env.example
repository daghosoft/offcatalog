# Copiare in docker/.env.local (escluso da git) e adattare. Valori d'esempio, non reali.

# Nome del progetto compose e del container
COMPOSE_PROJECT_NAME=offcatalog
OFFCAT_CONTAINER_NAME=offcatalog

# Porta sull'host e indirizzo su cui e' pubblicata (default: solo loopback)
OFFCAT_PORT=8080
OFFCAT_BIND=127.0.0.1

# Rete Docker dedicata e IP fisso del container (utile per regole firewall verso il container).
# L'IP deve stare dentro la subnet; scegliere una subnet libera sull'host.
OFFCAT_SUBNET=172.31.250.0/24
OFFCAT_IP=172.31.250.5

# Cartelle dell'host montate nel container: lavoro (download, CSV, build.db, state.db) e uscita (off_catalog.db).
# Devono esistere ed essere scrivibili dall'utente OFFCAT_UID/OFFCAT_GID. Servono circa 12 GB liberi nella cartella di lavoro.
OFFCAT_WORK_HOST_DIR=/srv/offcatalog/work
OFFCAT_OUTPUT_HOST_DIR=/srv/offcatalog/output
OFFCAT_UID=1000
OFFCAT_GID=1000

# Pannello (HTTP Basic): obbligatori, salvo OFFCAT_NO_AUTH=1 (solo sviluppo locale)
OFFCAT_PANEL_USER=admin
OFFCAT_PANEL_PASSWORD=changeme
OFFCAT_NO_AUTH=0

# Indirizzi ammessi a /api/* (senza credenziali), separati da virgola
OFFCAT_API_ALLOW=127.0.0.1,172.16.0.0/12

# Catalogo. COUNTRIES, MIN_PRODUCTS e KEEP_WORK (come i filtri kcal e coerenza) si possono cambiare anche dal pannello:
# il valore salvato dal pannello ha la precedenza su queste variabili.
OFFCAT_COUNTRIES=en:italy
OFFCAT_MIN_PRODUCTS=100000
OFFCAT_SOURCE_URL=https://static.openfoodfacts.org/data/en.openfoodfacts.org.products.csv.gz
# 1 = conserva CSV e build.db dopo la pubblicazione (diagnosi)
OFFCAT_KEEP_WORK=0

TZ=UTC
